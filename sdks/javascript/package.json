{
  "name": "socialpublishkit",
  "version": "0.1.1",
  "description": "Node.js SDK for the local SocialPublishKit publishing gateway",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/client.test.js",
    "typecheck": "tsc --strict --noEmit --module nodenext --target es2022 test/types.mts"
  },
  "license": "MIT",
  "author": "Foromo Daniel Soromou",
  "homepage": "https://github.com/caporalCoder/socialpublishkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/caporalCoder/socialpublishkit.git",
    "directory": "sdks/javascript"
  },
  "keywords": [
    "social-media",
    "publishing",
    "tiktok",
    "instagram",
    "facebook",
    "youtube"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
